<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MyStudio</AssemblyName>
    <RootNamespace>MyStudio.WinUI</RootNamespace>
    <Version>2.2.0</Version>
    <InformationalVersion>2.2.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>MyStudio</Product>
    <ApplicationIcon>../src/TeleStudio.Desktop/Assets/Brand/EssaStudio.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <EmbeddedResource Include="Assets/opal-supported-studios.json" LogicalName="MyStudio.WinUI.OpalSupportedStudios" />
    <Content Include="../src/TeleStudio.Desktop/Assets/Brand/EssaStudio.ico" Link="Assets/EssaStudio.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../src/TeleStudio.Desktop/TeleStudio.Desktop.csproj" />
  </ItemGroup>
  <Target Name="CopyWinUIApplicationResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <WinUIApplicationResource Include="$(TargetDir)$(AssemblyName).pri" />
      <WinUIApplicationResource Include="$(TargetDir)App.xbf" />
    </ItemGroup>
    <Error Condition="!Exists('%(WinUIApplicationResource.Identity)')" Text="Missing generated WinUI application resource: %(WinUIApplicationResource.Identity)" />
    <Copy SourceFiles="@(WinUIApplicationResource)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
