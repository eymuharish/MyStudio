+bool BFCPSession::RequestFloor(bool release)
+{
+  if (!m_clientServerStarted || m_participant == NULL ||
+      m_participant->m_BFCPParticipant == NULL || m_floorStreamMap.empty())
+    return false;
+  if (release)
+    return m_participant->m_BFCPParticipant->bfcp_floorRelease_participant() != -1;
+  // Stock SDP maps both main and presentation streams to floors. Request the
+  // dedicated presentation floor rather than whichever map entry sorts first.
+  OpalRTPConnection * connection = dynamic_cast<OpalRTPConnection *>(&m_connection);
+  OpalMediaSession * presentation = connection != NULL ? connection->FindSessionByMediaType(
+      OpalPresentationVideoMediaDefinition::Name()) : NULL;
+  if (presentation == NULL)
+    return false;
+  for (FloorStreamMap::const_iterator it = m_floorStreamMap.begin(); it != m_floorStreamMap.end(); ++it) {
+    if (it->second == presentation->GetSessionID())
+      return m_participant->m_BFCPParticipant->bfcp_floorRequest_participant((UINT16)it->first) != -1;
+  }
+  return false;
+}
