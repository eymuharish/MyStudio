+OpalTransportPtr SIPConnection::GetEstablishedDialogTransport() const
+{
+  OpalTransportPtr flow = m_establishedDialogTransport;
+  if (flow == NULL || !flow->IsOpen() || !flow->IsReliable())
+    return NULL;
+  OpalTransportAddress nextHop = GetRemoteTransportAddress();
+  OpalTransportAddress peer = flow->GetRemoteAddress();
+  PIPSocket::Address nextIP, peerIP;
+  if (nextHop.GetProtoPrefix() != peer.GetProtoPrefix() ||
+      !nextHop.GetIpAddress(nextIP) || !peer.GetIpAddress(peerIP) || nextIP != peerIP)
+    return NULL;
+  return flow;
+}
