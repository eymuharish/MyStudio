@@ -191,6 +191,31 @@
 BFCPSDPMediaDescription::BFCPSDPMediaDescription(const OpalTransportAddress & localAddress)
   : SDPApplicationMediaDescription(localAddress)
 {
+  m_mediaType = BFCPMediaDefinition::Name();
+}
+
+SDPMediaFormat * BFCPSDPMediaDescription::CreateSDPMediaFormat()
+{
+  return new Format(*this);
+}
+
+bool BFCPSDPMediaDescription::Format::FromSDP(const PString & value)
+{
+  if (value != "*")
+    return false;
+  FromMediaFormat(BFCPMediaFormat::Get());
+  return true;
+}
+
+void BFCPSDPMediaDescription::Format::FromMediaFormat(const OpalMediaFormat & format)
+{
+  SDPMediaFormat::FromMediaFormat(format);
+  m_encodingName = "*";
+}
+
+void BFCPSDPMediaDescription::Format::PrintOn(ostream &) const
+{
+  // Control SDP has no RTP attributes; the m-line uses m_encodingName.
+}
+
+bool BFCPSDPMediaDescription::Format::PostDecode(const OpalMediaFormatList & formats, unsigned)
+{
+  // BFCP is a control protocol; the '*' token is not an RTP codec/payload.
+  if (m_mediaFormat != BFCPMediaFormat::Get() || !formats.HasFormat(BFCPMediaFormat::Get()))
+    return false;
+  m_mediaFormat.SetOptionString(OpalMediaFormat::ProtocolOption(), "SIP");
+  return true;
 }
 
 
