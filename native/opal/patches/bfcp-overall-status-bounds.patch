+    oRS = (bfcp_overall_request_status *)calloc(1, sizeof(*oRS));
+    if (oRS) {
+        oRS->frqID = frqID;
+        oRS->rs = rs;
+        oRS->sInfo = sInfo;
+        rs = NULL;
+        sInfo = NULL;
+    }
+done:
+    if (attribute)
+        bfcp_free_received_attribute(attribute);
+    if (rs)
+        bfcp_free_request_status(rs);
+    if (sInfo)
+        free(sInfo);
+    message->position = recvA->position+((recvA->length+3)&~3);
+    return oRS;
 }
 
