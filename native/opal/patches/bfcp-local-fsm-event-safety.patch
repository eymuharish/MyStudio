diff --git a/src/sdp/bfcpinterface.cxx b/src/sdp/bfcpinterface.cxx
--- a/src/sdp/bfcpinterface.cxx
+++ b/src/sdp/bfcpinterface.cxx
@@ -862,14 +862,15 @@
   if (!m_clientServerStarted || m_participant == NULL ||
       m_participant->m_BFCPParticipant == NULL || m_floorStreamMap.empty())
     return false;
+  s_bfcp_msg_event event = {}; // Local control has no received wire status.
   if (release)
-    return m_participant->m_BFCPParticipant->FsmCtrlPerform(BFCP_fsm::BFCP_ACT_FloorRelease);
+    return m_participant->m_BFCPParticipant->FsmCtrlPerform(BFCP_fsm::BFCP_ACT_FloorRelease, &event);
   // Stock SDP maps both main and presentation streams to floors. Request the
   // dedicated presentation floor rather than whichever map entry sorts first.
   OpalRTPConnection * connection = dynamic_cast<OpalRTPConnection *>(&m_connection);
   for (FloorStreamMap::const_iterator it = m_floorStreamMap.begin(); it != m_floorStreamMap.end(); ++it) {
     if (IsPresentationFloor(connection, it->second))
-      return m_participant->m_BFCPParticipant->FsmCtrlPerform(BFCP_fsm::BFCP_ACT_FloorRequest);
+      return m_participant->m_BFCPParticipant->FsmCtrlPerform(BFCP_fsm::BFCP_ACT_FloorRequest, &event);
   }
   return false;
 }
