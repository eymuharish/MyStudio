+
+void BFCPSession::LibParticipantWrapper::StopParticipant()
+{
+  // The timer and wire threads call this wrapper. Join them before destroying it.
+  m_keepAliveTimer.Stop();
+  if (m_BFCPParticipant != NULL) {
+    m_BFCPParticipant->disconnect();
+    delete m_BFCPParticipant;
+    m_BFCPParticipant = NULL;
+  }
+}
 
