+
+// Snapshot the source before locking the destination, so reciprocal assignment
+// cannot invert two map mutexes. Signalling owns the non-map SDP attributes.
+BFCPDescription::BFCPDescription(const BFCPDescription & other)
+{
+  PWaitAndSignal lock(other.m_floorStreamMutex);
+  m_floorCtrl = other.m_floorCtrl;
+  m_confID = other.m_confID;
+  m_userID = other.m_userID;
+  m_transportProto = other.m_transportProto;
+  m_floorStreamMap = other.m_floorStreamMap;
+}
+
+BFCPDescription & BFCPDescription::operator=(const BFCPDescription & other)
+{
+  if (this == &other)
+    return *this;
+  const BFCPDescription snapshot(other);
+  PWaitAndSignal lock(m_floorStreamMutex);
+  m_floorCtrl = snapshot.m_floorCtrl;
+  m_confID = snapshot.m_confID;
+  m_userID = snapshot.m_userID;
+  m_transportProto = snapshot.m_transportProto;
+  m_floorStreamMap = snapshot.m_floorStreamMap;
+  return *this;
+}
+
+BFCPDescription::FloorStreamMap BFCPDescription::GetFloorStreamMap() const
+{
+  PWaitAndSignal lock(m_floorStreamMutex);
+  return m_floorStreamMap;
+}
+
+void BFCPDescription::SetFloorStreamMap(const FloorStreamMap & map)
+{
+  PWaitAndSignal lock(m_floorStreamMutex);
+  m_floorStreamMap = map;
+}
+
+bool BFCPDescription::HasFloorID(unsigned floorID) const
+{
+  PWaitAndSignal lock(m_floorStreamMutex);
+  return m_floorStreamMap.find(floorID) != m_floorStreamMap.end();
