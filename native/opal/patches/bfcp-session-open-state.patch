 const PCaselessString & BFCPSession::GetSessionType() const
 {
   return GetTransportProto();
+}
+
+
+// BFCP owns libbfcp sockets, not an OpalMediaTransport.
+bool BFCPSession::IsOpen() const
+{
+  if (!m_clientServerStarted || m_participant == NULL ||
+      m_participant->m_BFCPParticipant == NULL ||
+      !m_participant->m_BFCPParticipant->isStarted() ||
+      !m_participant->m_BFCPParticipant->isConnected())
+    return false;
+  // A passive/UDP role also owns its FCS listener; the active TCP role does not.
+  return m_server != NULL && (m_server->m_BFCPServer == NULL ||
+      (m_server->m_BFCPServer->isStarted() && m_server->m_BFCPServer->isConnected()));
+}
+
+bool BFCPSession::Close()
+{
+  m_clientServerStarted = false;
+  if (m_participant != NULL)
+    m_participant->StopParticipant();
+  if (m_server != NULL)
+    m_server->StopServer();
+  m_floorOwnerID = 0;
+  return true;
 }
 
 
